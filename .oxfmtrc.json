{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"singleQuote": true,
	"useTabs": true,
	"semi": false,
	"trailingComma": "all",
	"printWidth": 80,
	"sortPackageJson": false,
	"ignorePatterns": [
		"**/node_modules",
		"**/dist",
		"**/.wrangler",
		"**/*.tsbuildinfo",
		"package-lock.json"
	]
}
